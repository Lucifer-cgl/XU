/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob:; frame-src 'self' blob: data:; object-src 'self' blob: data:; media-src 'self' blob: data:; worker-src 'self' blob:; base-uri 'self'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/content/*
  Cache-Control: public, max-age=300, must-revalidate

/generated/*
  Cache-Control: public, max-age=300, must-revalidate
